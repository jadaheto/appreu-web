# Plantilla procesada por envsubst al arrancar el contenedor (imagen oficial de nginx).
# Solo se sustituyen las variables definidas en el entorno: ${NGINX_PORT}, ${APREU_API_URL}
# y ${CLIENT_MAX_BODY_SIZE}; las variables propias de nginx ($host, $uri…) quedan intactas.
server {
    listen ${NGINX_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API de apreu-api (desplegada aparte). Sin barra final: se reenvía la ruta completa /api/...
    location /api/ {
        proxy_pass ${APREU_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
    }

    # Archivos con hash de Angular: caché larga.
    location ~* \.(?:js|css|woff2?|ttf|png|jpe?g|gif|svg|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA: cualquier ruta desconocida carga index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
