# ============================================================
# apreu-web · variables del contenedor nginx (se leen al arrancar, no en el build)
# ============================================================
# URL de apreu-api SIN barra final ni ruta: nginx reenvía /api/... tal cual.
# Ej.: http://apreu-api:3000 (misma red Docker) o https://api.apreu.co
APREU_API_URL=http://apreu-api:3000
# Tamaño máximo de subida (fotos, logos, adjuntos)
CLIENT_MAX_BODY_SIZE=20m
NGINX_PORT=80

# Nota: el dominio raíz de los colegios (<slug>.apreu.co) se fija en el build,
# en src/environments/environment.ts (baseDomain). Recuerde agregar el dominio
# público de esta app a CORS_ORIGINS de apreu-api si el navegador llama a la API directamente.
